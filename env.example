# Шаблон переменных окружения CurlyParty.
# Скопируйте файл в env.env и заполните токены:
#   PowerShell:  Copy-Item env.example env.env
#   bash:        cp env.example env.env

DiscordToken=
TelegramToken=

TZ=Europe/Minsk
LD_LIBRARY_PATH=/app:/usr/lib
VoiceSettings__MaxTextLength=550
LAVALINK_HOST=lavalink
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass

VoiceTemplates__SingleUser="Приветствуем {User}"
VoiceTemplates__SingleUserWithActivity="Приветствуем {User}, который сейчас играет в {Activity}"
VoiceTemplates__GroupUsers="Приветствуем компанию: {Users}"

VoiceTemplates__TalkCommand="{Text}"
VoiceTemplates__TalkNotifySender="Вы отправили игроку {Recipient} сообщение:"
VoiceTemplates__TalkNotifyRecipient="Игрок {Sender} сказал вам:"
VoiceTemplates__TalkNotifySelf="Вы отправили сообщение самому себе:"

# --- Identity / PostgreSQL (запуск сервисов вне Docker) ---
IdentityService__BaseUrl=http://localhost:8081
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=curlypartydb;Username=curlyparty;Password=curlyparty_dev

# --- RabbitMQ (docker compose переопределяет хост, логин и пароль) ---
RabbitMq__Host=localhost
RabbitMq__Port=5672
RabbitMq__UserName=curlyparty
RabbitMq__Password=curlyparty_dev

# --- Telegram ---
Telegram__MaxTextLength=550
Telegram__AdminUserIds__0=

# --- Дебаговый оркестр: внешний PostgreSQL (docker-compose.debug.yml) ---
# Раскомментируйте и измените, если база/роль/пароль отличаются от значений
# из scripts/sql/*.sql. Скрипт scripts/compose-up.ps1 передаёт этот файл
# в docker compose как --env-file, поэтому переменные отсюда подхватываются.
# CURLYPARTY_DB_HOST=postgresdb
# CURLYPARTY_DB_PORT=5432
# CURLYPARTY_DB_NAME=curlypartydb
# CURLYPARTY_DB_USER=curlyparty
# CURLYPARTY_DB_PASSWORD=curlyparty_dev
