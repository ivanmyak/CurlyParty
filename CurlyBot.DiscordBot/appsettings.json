{
  "DiscordToken": "ТВОЙ_ТОКЕН_ДЛЯ_ЛОКАЛЬНОЙ_ОТЛАДКИ",
  "IdentityService": {
    "BaseUrl": "http://localhost:8081",
    "TimeoutSeconds": 15
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "UserName": "curlybot",
    "Password": "curlybot_dev",
    "VirtualHost": "/",
    "Exchange": "curlybot.events"
  },
  "SpeechClient": {
    "ReplyQueue": "curlybot.speech.replies.discord",
    "TimeoutSeconds": 180
  },
  "VoiceSettings": {
    "MaxTextLength": 550,
    "DebounceDelayMilliseconds": 1000,
    "DefaultVoiceModel": "ru_RU-denis-medium.onnx"
  },
  "VoiceTemplates": {
    "SingleUser": "Приветствуем {User}",
    "SingleUserWithActivity": "Приветствуем {User}, который сейчас играет в {Activity}",
    "GroupUsers": "Приветствуем компанию: {Users}",

    "TalkCommand": "{Text}",
    "TalkNotifySender": "Вы отправили игроку {Recipient} сообщение:",
    "TalkNotifyRecipient": "Игрок {Sender} сказал вам:",
    "TalkNotifySelf": "Вы отправили сообщение самому себе:"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
